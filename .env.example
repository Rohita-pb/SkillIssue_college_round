NODE_ENV=production
PORT=3001
# The database URL must use the same credentials as these Postgres settings.
POSTGRES_DB=agentbreak
POSTGRES_USER=agentbreak
POSTGRES_PASSWORD=change-me
# These hostnames are for docker compose. Use localhost when running Node directly.
DATABASE_URL=postgresql://agentbreak:change-me@postgres:5432/agentbreak
REDIS_URL=redis://redis:6379
# Set either this RS256 public key or the JWT secret below. Leave both blank
# until real values are provisioned; production startup rejects missing keys.
AGENTBREAK_JWT_PUBLIC_KEY=
AGENTBREAK_JWT_SECRET=
AGENTBREAK_JWT_ISSUER=agentbreak
AGENTBREAK_JWT_AUDIENCE=agentbreak-api
AGENTBREAK_CORS_ORIGINS=http://localhost:5173
AGENTBREAK_OPERATOR_TOKEN=
AGENTBREAK_GATEWAY_TOKEN=
AGENTBREAK_AUDIT_SIGNING_SECRET=
AGENTBREAK_AUDIT_SIGNING_KEY_ID=
AGENTBREAK_AWS_KMS_KEY_ID=
AWS_REGION=
